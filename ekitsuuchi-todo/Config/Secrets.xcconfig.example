// このファイルを Secrets.xcconfig にコピーして鍵を入れる（scripts/bootstrap.sh がコピーまでやる）。
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
// Secrets.xcconfig は git に入れない（Config/.gitignore で除外済み）。
//
// 鍵は Google Cloud Console で作り、必ず制限をかける:
//   - アプリケーションの制限: iOS アプリ → バンドル ID dev.denkingon.ekitsuuchi
//   - API の制限: Places API (New) のみ
// 鍵はアプリに同梱されるので、制限が実質の防御になる。
PLACES_API_KEY = PASTE_YOUR_KEY_HERE

// 署名の Team ID（10 桁。Xcode > Settings > Accounts のチーム、または developer.apple.com の Membership）。
// project.yml には書かない（`xcodegen generate` のたびに Xcode での選択が消えるため）。
DEVELOPMENT_TEAM =
